# Local only. DEMO is offline; TikTok LIVE requires Internet and third-party signing.
# Never put TikTok passwords, cookies or session tokens here.
PORT=3000

# Optional voice that reads viewer names and fortunes; requires Internet,
# Python with requirements.txt, and FFmpeg. Keep disabled for offline DEMO.
TTS_DYNAMIC_ENABLED=0
# TTS_PYTHON=D:/OnlinePagoda/.venv/Scripts/python.exe
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Optional: start without opening browser tabs automatically.
# NO_BROWSER=1
